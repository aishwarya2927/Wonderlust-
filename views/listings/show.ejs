<%layout("/layouts/boilerplate")%>

    <div class="row mb-3">
      <div class="col-8 offset-2 mt-2">
 <h3> <b><%= listing.title %></b></h3>
</div>
    <div class="card col-6 offset-3 mt-3 show-card listing-card">
      <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_image" />
 <div class="card-body">
             <p class="card-text">
           Owned by : <%= listing.owner.username%><br>
               &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
            <%= listing.description %> <br>

          <%= listing.location %> <br>
          <%= listing.country %> <br>  
          </p>
          </div>

      </div>
    </div>
   <br>
 <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
<div class="btns">
 <a class=" btn btn-dark offset-3 edit-btn" href="/listings/<%= listing._id %>/edit">Edit</a> 
   <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
      <button class=" btn btn-dark offset-5" >Delete</button>
    </form>
</div>
<% } %>

<hr>

<% if(currentUser) { %>
<div class="col-8 offset-3 mt-3 mb-3">
  <h4>Leave a Review </h4>
  <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate n class="needs-validation">
     
<fieldset class="starability-slot">
  <p>Rating</p>
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>

     <div class="mt-3 mb-3">
      <label for="comment" class="form-label">Comments</label>
      <textarea name="review[comment]" id="comment" cols="50" rows="5" class="form-control" required></textarea>
      <div class="invalid-feedback">
        Please add some valid comments for review
      </div>
     </div>

      <button class="btn btn-outline-dark">Submin</button>
  </form>
  <%}%>

<hr>
<p><b>All Reviews </b></p>
 <div class="row">
 <% for(review of listing.reviews){ %>
  <div class="card col-5 ms-3 mb-3 ">

 <div class="card-body">
  <h5 class="card-title">@<%= review.author.username %></h5>
    <p class="starability-result card-text" data-rating="<%=review.rating%>"></p>
    <p class="card-text"><%=review.comment%> </p>   
      <form class="mb-3" method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">      
        <button class="btn btn-sm btn-dark">Delete</button>    
      </form>
    </div>
  </div>
  <%}%>
  </div>
  </div>
</div>
 
<br><br>


   
