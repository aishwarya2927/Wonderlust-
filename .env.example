# MongoDB Atlas Connection URL
# Replace with your actual username, password, and cluster details
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wanderlust?retryWrites=true&w=majority

# Cloudinary Credentials (for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Session Secret (any long random string)
SECRET=mysupersecretcode

# Node Environment
NODE_ENV=production

# Server Port (optional locally, automatically injected by Render in production)
PORT=8080
